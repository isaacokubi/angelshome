NODE_ENV=production
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
CLIENT_ORIGINS=https://your-frontend-domain.example
CLIENT_URL=https://your-frontend-domain.example
JSON_BODY_LIMIT=2mb
GLOBAL_RATE_LIMIT=200
AUTH_RATE_LIMIT=20
PUBLIC_WRITE_RATE_LIMIT=30
PAYMENT_RATE_LIMIT=10
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
SCHOOL_TIMEZONE=Africa/Nairobi
CRON_SECRET=

# Cloudinary media storage (used for direct browser uploads up to 100 MB videos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Africa's Talking SMS
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# M-Pesa
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-api-domain.example/api/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=AngelsHomeSchool
MPESA_TRANSACTION_DESC=School Donation

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_DONATION_DESCRIPTION=Angels Home Education Center Donation
PAYPAL_BRAND_NAME=Angels Home Education Center
USD_KES_RATE=

# First administrator bootstrap (used only by npm run create-admin)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
